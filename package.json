		"configuration": {
			"title": "Revwise",
			"properties": {
				"revwise.currentLine.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Show blame at the end of the current line."
				},
				"revwise.currentLine.format": {
					"type": "string",
					"default": "${author}, ${ago} • ${summary}",
					"markdownDescription": "Format of the current-line annotation. Tokens: `${author}`, `${email}`, `${ago}`, `${date}`, `${sha}`, `${summary}`."
				},
				"revwise.currentLine.delay": {
					"type": "number",
					"default": 100,
					"minimum": 0,
					"description": "Debounce (ms) after cursor movement before blaming the line."
				},
				"revwise.statusBar.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Show blame for the current line in the status bar."
				},
				"revwise.statusBar.format": {
					"type": "string",
					"default": "${author}, ${ago}",
					"description": "Format of the status bar item. Same tokens as currentLine.format."
				},
				"revwise.hovers.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Show commit details when hovering the current line."
				},
				"revwise.hovers.over": {
					"type": "string",
					"enum": [
						"annotation",
						"line"
					],
					"default": "annotation",
					"description": "Trigger the hover over the annotation only, or anywhere on the line."
				},
				"revwise.codeLens.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Show recent-change and authors CodeLens at the top of files."
				},
				"revwise.fileBlame.format": {
					"type": "string",
					"default": "${agoShort|4} ${author|14} ${summary}",
					"description": "Format of gutter (file) blame. Same tokens as currentLine.format; append |N to a token (e.g. ${author|14}) to pad or truncate it to N characters so columns line up."
				},
				"revwise.history.limit": {
					"type": "number",
					"default": 200,
					"minimum": 1,
					"description": "Maximum commits shown in File History."
				},
				"revwise.youEmail": {
					"type": "string",
					"default": "",
					"description": "Your git email; matching authors render as \"You\"."
				},
				"revwise.heatmap.ageThreshold": {
					"type": "number",
					"default": 90,
					"minimum": 1,
					"description": "Lines changed within this many days are \"hot\" in the heatmap; older lines are \"cold\"."
				},
				"revwise.blame.detectMoves": {
					"type": "string",
					"enum": [
						"off",
						"file",
						"files"
					],
					"enumDescriptions": [
						"Plain blame (fastest).",
						"Follow lines moved within the file (git blame -M).",
						"Also follow lines moved or copied from other files in the same commit (git blame -C). Slower on large files."
					],
					"default": "file",
					"description": "Attribute moved/copied lines to the commit that originally wrote them instead of the commit that moved them."
				},
				"revwise.blame.ignoreWhitespace": {
					"type": "boolean",
					"default": false,
					"description": "Ignore whitespace-only changes when blaming (git blame -w)."
				},
				"revwise.blame.ignoreRevsFile": {
					"type": "string",
					"default": ".git-blame-ignore-revs",
					"markdownDescription": "File (relative to the repository root) listing commits to skip in blame, e.g. mass-formatting commits. Used when it exists. Set to empty to disable. Same format as `git blame --ignore-revs-file`."
				},
				"revwise.branchCleanup.protected": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"main",
						"master",
						"develop",
						"dev",
						"trunk",
						"release/*"
					],
					"description": "Branches (globs with *) that Clean Up Branches never offers to delete."
				},
				"revwise.branchCleanup.staleDays": {
					"type": "number",
					"default": 90,
					"minimum": 1,
					"description": "Branches with no commits for this many days are listed as stale (not preselected)."
				}
			}
		},
		"colors": [
			{
				"id": "revwise.trailingLineForegroundColor",
				"description": "Current-line blame annotation text.",
				"defaults": {
					"dark": "#99999959",
					"light": "#99999959",
					"highContrast": "#99999999"
				}
			},
			{
				"id": "revwise.gutterForegroundColor",
				"description": "Gutter blame text.",
				"defaults": {
					"dark": "#BEBEBE",
					"light": "#747474",
					"highContrast": "#FFFFFF"
				}
			},
			{
				"id": "revwise.gutterBackgroundColor",
				"description": "Gutter blame background.",
				"defaults": {
					"dark": "#FFFFFF13",
					"light": "#0000000C",
					"highContrast": "#FFFFFF13"
				}
			},
			{
				"id": "revwise.changesAddedColor",
				"description": "File Changes annotation: added lines.",
				"defaults": {
					"dark": "#587c0c",
					"light": "#48985d",
					"highContrast": "#487e02"
				}
			},
			{
				"id": "revwise.changesModifiedColor",
				"description": "File Changes annotation: modified lines.",
				"defaults": {
					"dark": "#0c7d9d",
					"light": "#2090d3",
					"highContrast": "#1b81a8"
				}
			},
			{
				"id": "revwise.changesDeletedColor",
				"description": "File Changes annotation: deleted lines marker.",
				"defaults": {
					"dark": "#94151b",
					"light": "#e51400",
					"highContrast": "#c74e39"
				}
			}
		]
	},
	"scripts": {
		"test": "node --test",

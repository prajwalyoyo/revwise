{
	"name": "revwise",
	"displayName": "Revwise — Blame, Graph & Undo for Git",
	"description": "Fast, private, no-account toolkit for Git: inline blame, commit graph, history rewriting with one-click undo, changelists, visual file history, local patches and branch cleanup. Free on every repo.",
	"version": "0.3.0",
	"publisher": "revwise",
	"license": "MIT",
	"author": "Prajwal Hoblidar",
	"icon": "resources/icon.png",
	"galleryBanner": {
		"color": "#2a1f6b",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/prajwalyoyo/revwise"
	},
	"bugs": {
		"url": "https://github.com/prajwalyoyo/revwise/issues"
	},
	"homepage": "https://github.com/prajwalyoyo/revwise#readme",
	"qna": "marketplace",
	"categories": [
		"SCM Providers",
		"Visualization",
		"Other"
	],
	"keywords": [
		"git",
		"blame",
		"graph",
		"history",
		"annotations",
		"heatmap",
		"branches",
		"stash",
		"worktree",
		"changelists",
		"rebase",
		"reword",
		"squash",
		"undo",
		"reflog",
		"patch"
	],
	"main": "./src/extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false,
			"description": "Revwise runs git in the workspace."
		},
		"virtualWorkspaces": false
	},
